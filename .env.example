# Copy to .env.local for local overrides. Never commit .env.local.
#
# The site is a static export served from Cloudflare static assets — there is
# no server, so there are no secrets here and none are needed.

# Absolute site URL, no trailing slash. Drives metadataBase, sitemap.xml and
# robots.txt. The deploy workflow sets https://portfolio.ancientsky14.workers.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Path prefix the site is served under. Empty locally and on Cloudflare; only
# the GitHub Pages build sets /portfolio (the repo is ancientsky14/portfolio).
NEXT_PUBLIC_BASE_PATH=
