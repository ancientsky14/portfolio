// portfolio-visits — the live visit count beside the handle in the rail.
// Deploy to Jan's OWN Cloudflare account, never a client's.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-visits",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"d1_databases": [
		{
			"binding": "VISITS_DB",
			"database_name": "portfolio-visits",
			// Paste the id printed by `npx wrangler d1 create portfolio-visits`.
			"database_id": "83fd7b22-382d-4dcf-b9e0-053ecbc59aed",
			"migrations_dir": "migrations"
		}
	],
	// Flood shield for POST /hit and /view (R23): thirty writes a minute per IP,
	// keyed by a salted hash. Generous on purpose — an office shares one IP.
	// Period must be 10 or 60. The contact Worker uses 2001; never share an id.
	"ratelimits": [
		{
			"name": "HIT_LIMITER",
			"namespace_id": "2002",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	],
	"vars": {
		// Who may read the count (GET /count).
		// Both hosts while the site moves to Cloudflare (R27); github.io goes
		// once it only redirects.
		"READ_ORIGINS": "https://portfolio.ancientsky14.workers.dev,https://ancientsky14.github.io,http://localhost:3000",
		// Who may add a visit (POST /hit) — the live site only.
		"HIT_ORIGINS": "https://portfolio.ancientsky14.workers.dev,https://ancientsky14.github.io"
	},
	// 02:00 Asia/Manila: drop visitor keys older than two days. Only the total
	// is kept long-term.
	"triggers": {
		"crons": [
			"0 18 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}