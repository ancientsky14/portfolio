// portfolio-contact — sends the contact form's briefs to Jan's inbox.
// Deploy to Jan's OWN Cloudflare account, never a client's.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-contact",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	// Required by worker-mailer (its README).
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			// src/index.ts reads env.CONTACT_DB. `wrangler d1 create` offers to
			// add a binding named after the database — keep this name instead.
			"binding": "CONTACT_DB",
			"database_name": "portfolio-contact",
			"database_id": "16b40fe5-0346-4627-9b4e-dfd6259f5b1e",
			"migrations_dir": "migrations"
		}
	],
	// Flood shield for POST /contact (R23): five requests a minute per visitor,
	// keyed by the salted IP hash. Period must be 10 or 60. The namespace id is
	// account-wide — the visits Worker uses 2002; never reuse one, or the two
	// Workers share counters.
	"ratelimits": [
		{
			"name": "SEND_LIMITER",
			"namespace_id": "2001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"vars": {
		// Who may send (POST /contact) — the live site only, as the visits
		// Worker does. Local testing sets its own in .dev.vars.
		"ALLOWED_ORIGINS": "https://ancientsky14.github.io",
		// Where briefs go. The address is already public on the site.
		"MAIL_TO": "janluigirivera@gmail.com"
	},
	// Secrets, never here: GMAIL_USER, GMAIL_APP_PASSWORD, TURNSTILE_SECRET,
	// IP_SALT — `npx wrangler secret put <NAME>` (see UPCOMING-FEATURES.md).
	// 02:15 Asia/Manila: delete emailed messages older than 30 days, and any
	// message older than 90.
	"triggers": {
		"crons": [
			"15 18 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}